# =====================================================================
# INDBIN CRM - Web Server Rules (.htaccess)
# Compatible with all shared & free hosting (InfinityFree, Hostinger, cPanel)
# =====================================================================

DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to sensitive config & core folders
    RewriteRule ^config\.php$ - [F,L]
    RewriteRule ^sql/.*$ - [F,L]
    RewriteRule ^core/.*$ - [F,L]
    RewriteRule ^storage/logs/.*$ - [F,L]
    RewriteRule ^storage/keys/.*$ - [F,L]
</IfModule>
